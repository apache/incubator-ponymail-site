  <Project rdf:about="https://ponymail.apache.org">
    <created>2016-05-27</created>
    <license rdf:resource="https://spdx.org/licenses/Apache-2.0" />
    <name>Apache Pony Mail</name>
    <homepage rdf:resource="https://ponymail.apache.org" />
    <asfext:pmc rdf:resource="https://ponymail.apache.org" />
    <shortdesc>Mail archiving, archive viewing, and mailing list interaction services.</shortdesc>
    <description>Apache Pony Mail is a web-based mail archive browser and interaction platform for mailing lists. It provides full-text search, threading, and real-time interaction with archived mailing lists, and is the engine behind lists.apache.org.</description>
    <bug-database rdf:resource="https://github.com/apache/incubator-ponymail-foal/issues" />
    <mailing-list rdf:resource="https://lists.apache.org/list.html?dev@ponymail.apache.org" />
    <download-page rdf:resource="https://ponymail.apache.org/downloads.html" />
    <programming-language>Python</programming-language>
    <programming-language>JavaScript</programming-language>
    <programming-language>Lua</programming-language>
    <category rdf:resource="https://projects.apache.org/category/mail" />
    <category rdf:resource="https://projects.apache.org/category/content" />
    <repository>
      <GitRepository>
        <location rdf:resource="https://github.com/apache/incubator-ponymail-foal.git"/>
        <browse rdf:resource="https://github.com/apache/incubator-ponymail-foal"/>
      </GitRepository>
    </repository>
    <repository>
      <GitRepository>
        <location rdf:resource="https://github.com/apache/incubator-ponymail.git"/>
        <browse rdf:resource="https://github.com/apache/incubator-ponymail"/>
      </GitRepository>
    </repository>
    <maintainer>
      <foaf:Person>
        <foaf:name>Apache Pony Mail PMC</foaf:name>
        <foaf:mbox rdf:resource="mailto:dev@ponymail.apache.org"/>
      </foaf:Person>
    </maintainer>
  </Project>
</rdf:RDF>
